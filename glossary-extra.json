      {"en": "histogram", "zh": "直方图", "usage": "Graph showing tonal distribution"},
      {"en": "dynamic range", "zh": "动态范围", "usage": "Span from darkest to brightest tones"},
      {"en": "highlight", "zh": "高光", "usage": "Brightest areas of the image"},

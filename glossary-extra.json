      {"en": "motion blur", "zh": "动态模糊", "usage": "Blurring from moving subject or camera"},
      {"en": "freeze action", "zh": "凝固动作", "usage": "Fast shutter speed to capture crisp motion"},
      {"en": "diffraction limited", "zh": "衍射极限", "usage": "Optimal aperture for lens sharpness"},
      {"en": "hyperfocus", "zh": "超焦距", "usage": "Setting for maximum depth of field"},
      {"en": "lens flare", "zh": "镜头眩光", "usage": "Light scattering causing artifacts"},
